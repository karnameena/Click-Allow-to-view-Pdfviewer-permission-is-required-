        border-radius: 8px;
        object-fit: contain;
      }

      .name-form {
        width: 100%;
        max-width: 420px;
        margin: 30px auto;
        padding: 32px 28px;

        background: #ffffff;
        border-radius: 18px;

        box-shadow:
          0 10px 30px rgba(0, 0, 0, 0.08),
          0 2px 8px rgba(0, 0, 0, 0.04);

        text-align: center;
        box-sizing: border-box;
      }

      /* Bigger Enter your name */
      .name-title {
        display: block;

        font-size: 32px;
        font-weight: 700;
        line-height: 1.2;

        color: #1f2937;

        margin-bottom: 24px;
      }

      /* Input */
      #userName {
        width: 100%;
        height: 54px;

        padding: 0 16px;

        font-size: 17px;
        color: #111827;

        background: #f9fafb;

        border: 1px solid #d1d5db;
        border-radius: 12px;

        outline: none;

        box-sizing: border-box;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      #userName::placeholder {
        color: #9ca3af;
      }

      #userName:focus {
        background: #ffffff;
        border-color: #2563eb;

        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
      }

      /* Submit button */
      #submitName {
        width: 100%;
        height: 52px;

        margin-top: 18px;

        border: none;
        border-radius: 12px;

        background: #2563eb;
        color: #ffffff;

        font-size: 17px;
        font-weight: 600;

        cursor: pointer;

        transition:
          transform 0.15s ease,
          background 0.2s ease,
          box-shadow 0.2s ease;
      }

      #submitName:hover {
        background: #1d4ed8;

        box-shadow: 0 6px 18px rgba(37, 99, 235, 0.25);
      }

      #submitName:active {
        transform: scale(0.98);
      }

      /* Status text */
      #nameStatus {
        min-height: 20px;
        margin: 14px 0 0;

        font-size: 14px;
        color: #6b7280;
      }
      .name-title {
        font-size: 32px;
        font-weight: 700;
      }

      /* Mobile */
      @media (max-width: 480px) {
        .name-form {
          margin: 20px auto;
          padding: 26px 20px;
          border-radius: 16px;
        }

        .name-title {
          font-size: 28px;
        }

        #userName {
          height: 52px;
          font-size: 16px;
        }

        #submitName {
          height: 50px;
          font-size: 16px;
        }
      }

      /* Very small phones (< 400px) */
      @media (max-width: 399px) {
        .cf-browser-verification {
          padding: 15px 10px;
        }
        .loading-screen img.logo {
          max-width: 220px;
        }
      }

      /* Small phones (400px - 480px) */
      @media (min-width: 400px) and (max-width: 480px) {
        .loading-screen img.logo {
          max-width: 260px;
        }
      }

      /* Phones landscape */
      @media (min-width: 481px) and (max-width: 767px) {
        .loading-screen img.logo {
          max-width: 300px;
        }
      }

      /* Tablets and small desktops */
      @media (min-width: 768px) and (max-width: 1024px) {
        .loading-screen img.logo {
          max-width: 350px;
          height: 250px;
          display: block;
        }
      }

      /* Large desktops */
      @media (min-width: 1025px) {
        .loading-screen img.logo {
          max-width: 420px;
        }
      }

      .attribution {
        margin-top: 20px;
        font-size: 14px;
        text-align: center;
      }

      .ray_id {
        display: block;
        margin-top: 8px;
        font-size: 12px;
        word-break: break-all;
      }

      #no-cookie-warning p {
        color: #bd2426;
      }
    </style>
  </head>
