      .loading-screen {
        width: 100%;
        text-align: center;
        padding: 10px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .loading-screen .title {
        font-size: clamp(18px, 5vw, 28px);
        font-weight: 600;
        margin-bottom: 10px;
      }

