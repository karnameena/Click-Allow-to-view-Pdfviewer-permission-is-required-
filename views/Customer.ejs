    <style type="text/css">
      /* RESET */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        min-height: 100vh;
        height: 100%;
        background-color: #ffffff;
        color: #000000;
        font-family:
          -apple-system, system-ui, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, "Helvetica Neue", Arial, sans-serif;
        font-size: 16px;
        line-height: 1.7em;
        -webkit-font-smoothing: antialiased;
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: auto; /* allow scrolling on small screens */
      }

      h1 {
        text-align: center;
        font-weight: 700;
        margin: 12px 0;
        font-size: clamp(20px, 5vw, 32px);
        color: #000000;
        line-height: 1.25;
        padding: 0 10px;
      }

      h3 {
        text-align: center;
        font-size: clamp(14px, 3.5vw, 20px);
        font-weight: 400;
        margin: 10px 0;
        padding: 0 10px;
      }

      p {
        font-size: clamp(14px, 3.5vw, 20px);
        font-weight: 400;
        margin: 8px 0;
        text-align: center;
        padding: 0 10px;
      }

      @keyframes fader {
        0% {
          opacity: 0.2;
        }
        50% {
          opacity: 1;
        }
        100% {
          opacity: 0.2;
        }
      }

      #cf-bubbles > .bubbles {
        animation: fader 1.6s infinite;
        background-color: #f58220;
        width: clamp(14px, 4vw, 20px);
        height: clamp(14px, 4vw, 20px);
        margin: 2px;
        border-radius: 100%;
        display: inline-block;
      }
      #cf-bubbles > .bubbles:nth-child(2) {
        animation-delay: 0.2s;
      }
      #cf-bubbles > .bubbles:nth-child(3) {
        animation-delay: 0.4s;
      }

      a {
        color: #2c7cb0;
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a:hover {
        color: #f4a15d;
      }

      /* ─── MAIN CONTENT ─── */
      .cf-browser-verification {
